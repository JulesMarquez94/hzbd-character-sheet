# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Env files (Vite loads .env too, not only .env.local — keep keys out of git)
.env
.env.*
!.env.example

# docs/rulebook.md was ignored here until 2026-09-04, on the grounds that it was
# a working document and "not the app". It is the app now: src/lib/rulebook.js
# imports it and /rules renders it, so a checkout without it cannot build. It is
# tracked, and this line is kept as the note of why it stopped being ignored.

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Supabase CLI scratch state. Written by `supabase link` and rewritten on every
# deploy. It names the linked project and caches server versions, so it is local
# machine state rather than anything the repository should carry.
supabase/.temp/

# The codex art uploader's receipt: the sha256 of every object as it was last
# pushed, so a second run sends only what changed. Local state and nothing else.
# Delete it and the next run re-uploads all of them, which costs time and no
# more. See scripts/push-codex-art.mjs.
.codex-art.json
